    {
      "id": "el3074",
      "type": "text",
      "x": 1366.7472490314965,
      "y": 492.75531340706425,
      "width": 384,
      "height": 243.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a90n",
      "roundness": null,
      "seed": 3074,
      "version": 84,
      "versionNonce": 1861016251,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780887413224,
      "link": null,
      "locked": false,
      "text": "1  You hold a Keystone token\n2  Exosphere snapshots + boots the clone\n3  Exosphere asks the sidecar for a pass\n     (sends the token)\n4  Sidecar validates the token w/ Keystone\n5  Sidecar uses the embed secret to\n     mint a pass from CloudShield\n6  Sidecar returns the pass to Exosphere\n7  Exosphere loads CloudShield's iframe\n8  CloudShield SSHes into the clone + scans\n\nNEEDS: we run CloudShield + sidecar + a\n     GPU (inference) on Jetstream.\nDOESN'T: touch CloudShield's code, or put\n     the secret in the browser.",
      "originalText": "1  You hold a Keystone token\n2  Exosphere snapshots + boots the clone\n3  Exosphere asks the sidecar for a pass\n     (sends the token)\n4  Sidecar validates the token w/ Keystone\n5  Sidecar uses the embed secret to\n     mint a pass from CloudShield\n6  Sidecar returns the pass to Exosphere\n7  Exosphere loads CloudShield's iframe\n8  CloudShield SSHes into the clone + scans\n\nNEEDS: we run CloudShield + sidecar + a\n     GPU (inference) on Jetstream.\nDOESN'T: touch CloudShield's code, or put\n     the secret in the browser.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "el3073",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 10
    },
