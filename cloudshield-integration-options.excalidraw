    {
      "id": "el3108",
      "type": "text",
      "x": 488,
      "y": 1133,
      "width": 384,
      "height": 195.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aI",
      "roundness": null,
      "seed": 3108,
      "version": 61,
      "versionNonce": 999216603,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780887369616,
      "link": null,
      "locked": false,
      "text": "1  You hold a Keystone token\n2  Exosphere snapshots + boots the clone\n3  Exosphere calls CloudShield to scan (+ token)\n4  CloudShield validates the token\n     (bridge built into our fork)\n5  CloudShield returns an embed pass\n6  Exosphere loads CloudShield's iframe\n7  CloudShield SSHes into the clone + scans\n\nNEEDS: we run + maintain a fork (rebases)\n     + a GPU on Jetstream.\nDOESN'T: need a sidecar.",
      "originalText": "1  You hold a Keystone token\n2  Exosphere snapshots + boots the clone\n3  Exosphere calls CloudShield to scan (+ token)\n4  CloudShield validates the token\n     (bridge built into our fork)\n5  CloudShield returns an embed pass\n6  Exosphere loads CloudShield's iframe\n7  CloudShield SSHes into the clone + scans\n\nNEEDS: we run + maintain a fork (rebases)\n     + a GPU on Jetstream.\nDOESN'T: need a sidecar.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "el3107",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 10
    },
