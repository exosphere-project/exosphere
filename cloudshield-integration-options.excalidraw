      "boundElements": [],
      "updated": 1780887369616,
      "link": null,
      "locked": false,
      "text": "1  Exosphere snapshots + boots the clone\n2  Exosphere triggers a scan\n3  CloudShield SSHes into the clone + scans\n4  CloudShield writes a results summary\n     to object storage\n5  Exosphere reads the summary\n     (plain API call, no pass)\n6  Exosphere renders the tile itself\n\nNEEDS: the scan to drop a summary into\n     object storage.\nDOESN'T: show CloudShield's UI, or run\n     inference unless added.",
      "originalText": "1  Exosphere snapshots + boots the clone\n2  Exosphere triggers a scan\n3  CloudShield SSHes into the clone + scans\n4  CloudShield writes a results summary\n     to object storage\n5  Exosphere reads the summary\n     (plain API call, no pass)\n6  Exosphere renders the tile itself\n\nNEEDS: the scan to drop a summary into\n     object storage.\nDOESN'T: show CloudShield's UI, or run\n     inference unless added.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "el3136",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 10
    }
