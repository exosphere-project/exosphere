    {
      "id": "el3036",
      "type": "text",
      "x": 470.2421875,
      "y": 449.1640625,
      "width": 420.0,
      "height": 195.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a90KV",
      "roundness": null,
      "seed": 3036,
      "version": 72,
      "versionNonce": 1790319611,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780887397957,
      "link": null,
      "locked": false,
      "text": "1  You already hold a Keystone token\n2  Exosphere snapshots the instance + boots a clone\n3  Exosphere calls CloudShield to scan,\n     passing the token   (new)\n4  CloudShield validates the token w/ Keystone   (new)\n5  CloudShield SSHes into the clone + scans\n6  CloudShield returns a short-lived embed pass   (new)\n7  Exosphere loads CloudShield's iframe\n\nNEEDS: CloudShield to accept a Keystone token\n     + CORS  (the 3 \"new\" steps).\nDOESN'T: need any server or secret on our side.",
      "originalText": "1  You already hold a Keystone token\n2  Exosphere snapshots the instance + boots a clone\n3  Exosphere calls CloudShield to scan,\n     passing the token   (new)\n4  CloudShield validates the token w/ Keystone   (new)\n5  CloudShield SSHes into the clone + scans\n6  CloudShield returns a short-lived embed pass   (new)\n7  Exosphere loads CloudShield's iframe\n\nNEEDS: CloudShield to accept a Keystone token\n     + CORS  (the 3 \"new\" steps).\nDOESN'T: need any server or secret on our side.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "el3035",
      "lineHeight": 1.25,
      "autoResize": false,
      "baseline": 10
    },
