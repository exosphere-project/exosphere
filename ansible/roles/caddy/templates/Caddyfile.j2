{
	# There is no admin email address in this deployment, so ACME registration
	# happens without an account email and the global email directive is left out
	# on purpose.

	# Only port 443 is open in this instance's security group, so the http to https
	# redirect vhost that Caddy would otherwise put on port 80 can never be
	# reached. Turn it off so Caddy stays off port 80 and leaves that port free for
	# whatever else the user runs on this instance.
	auto_https disable_redirects
{% if caddy_floating_ipv4 | length > 0 %}

	# Browsers do not send SNI when the URL is an IP literal, so Caddy picks a
	# certificate by the connection's local address. A NAT'd floating IPv4 arrives
	# with the private fixed IP as the local address, and there is no certificate
	# for that, so IPv4 handshakes fail without this line. IPv6 is routed rather
	# than NAT'd and does not need it.
	fallback_sni {{ caddy_floating_ipv4 }}
{% endif %}
}

(guacamole_site) {
	tls {
		issuer acme {
			# Let's Encrypt only issues certificates for IP addresses under the
			# shortlived profile, which has a lifetime of about six days. Caddy
			# renews automatically.
			profile shortlived

			# Port 80 is closed, so HTTP-01 can never complete. Without this Caddy
			# tries it and stalls quietly. TLS-ALPN-01 on port 443 is the challenge
			# that works here.
			disable_http_challenge
		}
	}

	# Guacamole's token endpoint is cross-origin when the browser talks to this
	# instance directly, so answer it with the CORS headers for the Exosphere
	# origin that launched this instance.
	@exosphere_token {
		path /guacamole/api/tokens
		header Origin "{{ exo_origin }}"
	}
	header @exosphere_token {
		Access-Control-Allow-Origin "{header.Origin}"
		Access-Control-Allow-Methods "POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type"
		Vary Origin
		defer
	}

	# Guacamole returns a 500 for OPTIONS on the token endpoint, so answer the
	# preflight here instead of passing it through.
	@exosphere_token_preflight {
		method OPTIONS
		path /guacamole/api/tokens
	}
	respond @exosphere_token_preflight 204

	redir / /guacamole/
	reverse_proxy 127.0.0.1:49528
}
{% if caddy_floating_ipv4 | length > 0 %}

https://{{ caddy_floating_ipv4 }} {
	import guacamole_site
}
{% endif %}
{% if caddy_global_ipv6 | length > 0 %}

https://[{{ caddy_global_ipv6 }}] {
	import guacamole_site
}
{% endif %}
